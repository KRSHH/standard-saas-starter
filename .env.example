# ============================================================
# Environment Variables
# Copy to `.env.local` and fill in. NEVER commit .env.local.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Acme"

# --- Supabase (Auth + Postgres + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # server only — NEVER expose

# --- Database (Drizzle, direct Postgres connection) ---
# Supabase pooler (pgBouncer) for serverless: port 6543
# Direct connection for migrations: port 5432
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Distributed rate limiting (required in production) ---
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Razorpay (optional — popular in India) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_STARTER_PLAN_ID=plan_xxx
RAZORPAY_PRO_PLAN_ID=plan_xxx

# --- Stripe (global payments) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="Acme <hello@yourdomain.com>"
EMAIL_REPLY_TO="hello@yourdomain.com"

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_xxx # server only

# --- Error Tracking (Sentry) ---
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_xxx

# --- AI (Vercel AI SDK) ---
# At least one provider must be set. Anthropic is recommended for general reasoning.
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
AI_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
