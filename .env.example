# ============================================================
# Environment Variables
#
# Copy to `.env.local` (or run `bun run setup`). NEVER commit .env.local.
#
# Convention: UNCOMMENTED vars are required to boot the app.
# Commented-out vars are OPTIONAL — every optional integration degrades
# gracefully when unset (no crashes, features just turn off).
# ============================================================

# --- App ---
# NEXT_PUBLIC_APP_URL: canonical origin (no trailing slash). Used for sitemap,
# canonical URLs, OG metadata, JSON-LD, and auth redirect targets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME: product name. Drives <title>, manifest, email branding,
# and the logo monogram initial. Default is "Acme".
NEXT_PUBLIC_APP_NAME="Acme"
# Optional social profiles — included in JSON-LD `sameAs` when set. Leave blank
# to omit. Used by the footer links as well.
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourbrand
# NEXT_PUBLIC_GITHUB_URL=https://github.com/yourbrand/yourrepo

# --- Supabase (Auth + Postgres + Storage) — REQUIRED ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — NEVER expose. Needed for uploads, account deletion, db:seed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Drizzle, direct Postgres connection) — REQUIRED ---
# Dashboard → Project Settings → Database → Connection string
# Supabase pooler (pgBouncer) for serverless runtime: port 6543
# Direct connection for migrations (db:migrate): port 5432
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Distributed rate limiting (Upstash Redis) ---
# Optional in dev (falls back to in-memory). REQUIRED in production —
# rate-limited routes intentionally fail closed without distributed storage.
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Cloudflare Turnstile (optional bot protection for auth forms) ---
# Opt-in. When the site key is set, the Turnstile widget renders on sign-in /
# sign-up. The SECRET key is NOT set here — paste it into the Supabase
# dashboard (Auth → Settings → Bot and Abuse Protection); Supabase verifies
# the token server-side. Leave blank to disable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# --- Stripe (optional — global card payments) ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_STARTER_PRICE_ID=price_xxx
# STRIPE_PRO_PRICE_ID=price_xxx

# --- Razorpay (optional — UPI/cards, popular in India) ---
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=whsec_xxx
# RAZORPAY_STARTER_PLAN_ID=plan_xxx
# RAZORPAY_PRO_PLAN_ID=plan_xxx

# --- Email (Resend — optional; transactional email is skipped without it) ---
# RESEND_API_KEY=re_xxx
# EMAIL_FROM: sender for transactional email. Must be on a verified domain
# (or the Resend sandbox address for dev).
# EMAIL_FROM="Acme <onboarding@resend.dev>"
# EMAIL_REPLY_TO="hello@yourdomain.com"
# RESEND_WEBHOOK_SECRET: signing secret for /api/webhooks/resend (bounce,
# complaint, delivery events). Find in the Resend dashboard under Webhooks.
# RESEND_WEBHOOK_SECRET=whsec_xxx
# NOTIFICATIONS_UNSUBSCRIBE_SECRET: HMAC secret for stateless unsubscribe
# tokens in transactional email. Optional in dev (derived); REQUIRED in prod.
# NOTIFICATIONS_UNSUBSCRIBE_SECRET=generate-a-long-random-string

# --- Analytics (PostHog — optional; events are no-ops without it) ---
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Error tracking (Sentry — optional; disabled without a DSN) ---
# NEXT_PUBLIC_SENTRY_DSN enables client, server, and edge error reporting.
# DSNs are safe to expose (submission-only).
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# Build-time source-map upload (real deploys only). When SENTRY_AUTH_TOKEN is
# set, next.config.ts wraps the build with withSentryConfig and uploads source
# maps to SENTRY_ORG/SENTRY_PROJECT.
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_xxx
