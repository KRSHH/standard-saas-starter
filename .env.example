# ============================================================
# Environment Variables
# Copy to `.env.local` and fill in. NEVER commit .env.local.
# ============================================================

# --- App ---
# NEXT_PUBLIC_APP_URL: canonical origin (no trailing slash). Used for sitemap,
# canonical URLs, OG metadata, JSON-LD, and auth redirect targets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME: product name. Drives <title>, manifest, email branding,
# and the logo monogram initial. Default is "Acme".
NEXT_PUBLIC_APP_NAME="Acme"
# Optional social profiles — included in JSON-LD `sameAs` when set. Leave blank
# to omit. Used by the footer links as well.
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourbrand
# NEXT_PUBLIC_GITHUB_URL=https://github.com/yourbrand/yourrepo

# --- Cloudflare Turnstile (optional bot protection for auth forms) ---
# Opt-in. When both keys are set, the Turnstile widget renders on sign-in /
# sign-up and the server verifies the token. Leave blank to disable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAB...

# --- Supabase (Auth + Postgres + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # server only — NEVER expose

# --- Database (Drizzle, direct Postgres connection) ---
# Supabase pooler (pgBouncer) for serverless: port 6543
# Direct connection for migrations: port 5432
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Distributed rate limiting (required in production) ---
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Razorpay (optional — popular in India) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_STARTER_PLAN_ID=plan_xxx
RAZORPAY_PRO_PLAN_ID=plan_xxx

# --- Stripe (global payments) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
# EMAIL_FROM: sender used for transactional email. Must be on a verified domain
# (or the Resend sandbox address for dev).
EMAIL_FROM="Acme <onboarding@resend.dev>"
EMAIL_REPLY_TO="hello@yourdomain.com"
# RESEND_WEBHOOK_SECRET: signing secret for /api/webhooks/resend (bounce,
# complaint, delivery events). Find in the Resend dashboard under Webhooks.
RESEND_WEBHOOK_SECRET=whsec_xxx
# NOTIFICATIONS_UNSUBSCRIBE_SECRET: HMAC secret for stateless unsubscribe
# tokens in transactional email. Optional in dev (derived); REQUIRED in prod.
# NOTIFICATIONS_UNSUBSCRIBE_SECRET=generate-a-long-random-string

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_xxx # server only

# --- Error Tracking (Sentry) ---
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_xxx
